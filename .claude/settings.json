{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo search:*)",
      "Bash(cargo run:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo check:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(echo \"exit: $?\")",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:taskwarrior.org)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path | select(endswith(\".rs\"))') && [ -n \"$FILE\" ] && cargo fmt -- \"$FILE\" || true"
          },
          {
            "type": "command",
            "command": ".claude/hooks/clippy.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/markdownlint.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/gui-check.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
